            "content": "// Incremental scan cache for CLI lint.\n//\n// Caches ScanOutput keyed on (file_path, content_hash, ruleset_hash,\n// profile, content_type, fix_mode).  Skips the entire scan pipeline on\n// cache hit.  TTL-based expiry (default 24h) prevents unbounded growth.\n// Entry count capped at MAX_ENTRIES to bound memory and disk usage.\n//\n// MCP path does NOT use this cache (stateless by design).\n// Shared infrastructure with 33.3 hook cache (same storage dir, same\n// sha256 hashing via audit::sha256_hex).\n//\n// Concurrency: flush uses tempfile + rename for atomic writes, preventing\n// corruption from concurrent CLI invocations.  Lost updates between\n// concurrent writers are tolerated (best-effort cache, not a database).\n\nuse std::collections::HashMap;\nuse std::path::{Path, PathBuf};\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::audit::sha256_hex;\nuse crate::engine::scan::ScanOutput;\n\n/// Default TTL in seconds (24 hours).\nconst DEFAULT_TTL_SECS: u64 = 24 * 60 * 60;\n\n/// Maximum number of cached entries.  Prevents unbounded growth when\n/// scanning large monorepos.  Oldest entries evicted first on overflow.\nconst MAX_ENTRIES: usize = 2000;\n\n/// Parameters that uniquely identify a scan invocation for caching.\npub struct ScanCacheKey<'a> {\n    pub file_path: &'a str,\n    pub content: &'a [u8],\n    pub ruleset_hash: &'a str,\n    pub profile: &'a str,\n    pub content_type: &'a str,\n    // Currently always \"None\" because caching is disabled when fix_mode\n    // is active.  Kept in the key for forward-compatibility if fix result\n    // caching is added later.\n    pub fix_mode: &'a str,\n}\n\n/// Internal cache key with content hash (not raw content).\n#[derive(Debug, Clone, Hash, PartialEq, Eq, Serialize, Deserialize)]\nstruct StoredKey {\n    file_path: String,\n    content_hash: String,\n    ruleset_hash: String,\n    profile: String,\n    content_type: String,\n    fix_mode: String,\n}\n\n/// A single cached entry with timestamp for TTL expiry.\n#[derive(Debug, Clone, Serialize, Deserialize)]\nstruct CacheEntry {\n    key: StoredKey,\n    output: ScanOutput,\n    timestamp_secs: u64,\n}\n\n/// Persistent scan cache backed by a JSON file.\n#[derive(Debug)]\npub struct ScanCache {\n    path: PathBuf,\n    entries: HashMap<String, CacheEntry>,\n    ttl_secs: u64,\n    dirty: bool,\n}\n\nimpl ScanCache {\n    /// Open (or create) the scan cache at the default location.\n    pub fn open_default() -> Self {\n        Self::open(default_cache_path())\n    }\n\n    /// Open (or create) the scan cache at a specific path.\n    pub fn open(path: PathBuf) -> Self {\n        let entries = load_entries(&path, DEFAULT_TTL_SECS);\n        ScanCache {\n            path,\n            entries,\n            ttl_secs: DEFAULT_TTL_SECS,\n            dirty: false,\n        }\n    }\n\n    /// Look up a cached scan result.  Returns None on cache miss or expired entry.\n    pub fn get(&self, params: &ScanCacheKey<'_>) -> Option<&ScanOutput> {\n        let stored = to_stored_key(params);\n        let hash = entry_hash(&stored);\n        let entry = self.entries.get(&hash)?;\n        let now = now_secs();\n        if now.saturating_sub(entry.timestamp_secs) > self.ttl_secs {\n            return None;\n        }\n        Some(&entry.output)\n    }\n\n    /// Store a scan result in the cache.\n    pub fn put(&mut self, params: &ScanCacheKey<'_>, output: ScanOutput) {\n        let stored = to_stored_key(params);\n        let hash = entry_hash(&stored);\n        self.entries.insert(\n            hash,\n            CacheEntry {\n                key: stored,\n                output,\n                timestamp_secs: now_secs(),\n            },\n        );\n        self.dirty = true;\n    }\n\n    /// Flush dirty cache to disk.  Prunes expired and overflow entries\n    /// before writing.  Uses tempfile + rename for atomic writes.\n    /// Errors are silently ignored (cache is best-effort).\n    pub fn flush(&mut self) {\n        if !self.dirty {\n            return;\n        }\n        // Prune expired entries.\n        let now = now_secs();\n        let ttl = self.ttl_secs;\n        self.entries\n            .retain(|_, e| now.saturating_sub(e.timestamp_secs) <= ttl);\n\n        // Evict oldest entries if over the cap.\n        if self.entries.len() > MAX_ENTRIES {\n            let mut by_time: Vec<(String, u64)> = self\n                .entries\n                .iter()\n                .map(|(k, e)| (k.clone(), e.timestamp_secs))\n                .collect();\n            by_time.sort_by_key(|(_, ts)| *ts);\n            let to_remove = self.entries.len() - MAX_ENTRIES;\n            for (k, _) in by_time.into_iter().take(to_remove) {\n                self.entries.remove(&k);\n            }\n        }\n\n        let Some(parent) = self.path.parent() else {\n            return;\n        };\n        let _ = std::fs::create_dir_all(parent);\n\n        // Atomic write: tempfile in same directory + rename.\n        let entries_vec: Vec<&CacheEntry> = self.entries.values().collect();\n        let Ok(json) = serde_json::to_vec(&entries_vec) else {\n            return;\n        };\n        let Ok(tmp) = tempfile::NamedTempFile::new_in(parent) else {\n            return;\n        };\n        if std::fs::write(tmp.path(), json).is_ok() {\n            // persist() does rename, which is atomic on POSIX.\n            let _ = tmp.persist(&self.path);\n        }\n        self.dirty = false;\n    }\n}\n\nimpl Drop for ScanCache {\n    fn drop(&mut self) {\n        self.flush();\n    }\n}\n\n/// Default cache file location: ~/.cache/zhtw-mcp/scan-cache.json\nfn default_cache_path() -> PathBuf {\n    cache_dir().join(\"zhtw-mcp\").join(\"scan-cache.json\")\n}\n\n/// Best-effort cache directory resolution without adding a dependency.\nfn cache_dir() -> PathBuf {\n    if let Ok(xdg) = std::env::var(\"XDG_CACHE_HOME\") {\n        if !xdg.is_empty() {\n            return PathBuf::from(xdg);\n        }\n    }\n    if let Ok(home) = std::env::var(\"HOME\") {\n        return PathBuf::from(home).join(\".cache\");\n    }\n    PathBuf::from(\"/tmp\")\n}\n\nfn to_stored_key(params: &ScanCacheKey<'_>) -> StoredKey {\n    StoredKey {\n        file_path: params.file_path.to_owned(),\n        content_hash: sha256_hex(params.content),\n        ruleset_hash: params.ruleset_hash.to_owned(),\n        profile: params.profile.to_owned(),\n        content_type: params.content_type.to_owned(),\n        fix_mode: params.fix_mode.to_owned(),\n    }\n}\n\nfn entry_hash(key: &StoredKey) -> String {\n    let composite = format!(\n        \"{}|{}|{}|{}|{}|{}\",\n        key.file_path,\n        key.content_hash,\n        key.ruleset_hash,\n        key.profile,\n        key.content_type,\n        key.fix_mode\n    );\n    sha256_hex(composite.as_bytes())\n}\n\nfn now_secs() -> u64 {\n    SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_secs()\n}\n\nfn load_entries(path: &Path, ttl_secs: u64) -> HashMap<String, CacheEntry> {\n    let bytes = match std::fs::read(path) {\n        Ok(b) => b,\n        Err(_) => return HashMap::new(),\n    };\n    let entries: Vec<CacheEntry> = match serde_json::from_slice(&bytes) {\n        Ok(v) => v,\n        Err(_) => return HashMap::new(),\n    };\n    let now = now_secs();\n    entries\n        .into_iter()\n        .filter(|e| now.saturating_sub(e.timestamp_secs) <= ttl_secs)\n        .map(|e| (entry_hash(&e.key), e))\n        .collect()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::engine::scan::ScanOutput;\n    use crate::engine::zhtype::ChineseType;\n    use tempfile::TempDir;\n\n    fn empty_output() -> ScanOutput {\n        ScanOutput {\n            issues: vec![],\n            detected_script: ChineseType::Traditional,\n        }\n    }\n\n    fn key<'a>(\n        file: &'a str,\n        content: &'a [u8],\n        profile: &'a str,\n        ct: &'a str,\n    ) -> ScanCacheKey<'a> {\n        ScanCacheKey {\n            file_path: file,\n            content,\n            ruleset_hash: \"rh\",\n            profile,\n            content_type: ct,\n            fix_mode: \"none\",\n        }\n    }\n\n    #[test]\n    fn cache_hit_and_miss() {\n        let dir = TempDir::new().unwrap();\n        let path = dir.path().join(\"cache.json\");\n        let mut cache = ScanCache::open(path);\n\n        let k = key(\"a.md\", b\"hello\", \"default\", \"markdown\");\n        assert!(cache.get(&k).is_none());\n\n        cache.put(&k, empty_output());\n        assert!(cache.get(&k).is_some());\n\n        // Different content = miss.\n        let k2 = key(\"a.md\", b\"world\", \"default\", \"markdown\");\n        assert!(cache.get(&k2).is_none());\n\n        // Different profile = miss.\n        let k3 = key(\"a.md\", b\"hello\", \"strict_moe\", \"markdown\");\n        assert!(cache.get(&k3).is_none());\n    }\n\n    #[test]\n    fn cache_persists_to_disk() {\n        let dir = TempDir::new().unwrap();\n        let path = dir.path().join(\"cache.json\");\n\n        {\n            let mut cache = ScanCache::open(path.clone());\n            cache.put(&key(\"b.md\", b\"data\", \"default\", \"plain\"), empty_output());\n            cache.flush();\n        }\n\n        let cache = ScanCache::open(path);\n        assert!(cache\n            .get(&key(\"b.md\", b\"data\", \"default\", \"plain\"))\n            .is_some());\n    }\n\n    #[test]\n    fn expired_entries_pruned() {\n        let dir = TempDir::new().unwrap();\n        let path = dir.path().join(\"cache.json\");\n        let mut cache = ScanCache::open(path);\n        cache.put(&key(\"c.md\", b\"x\", \"default\", \"plain\"), empty_output());\n        // Backdate the entry to force expiry.\n        for entry in cache.entries.values_mut() {\n            entry.timestamp_secs = 0;\n        }\n        assert!(cache.get(&key(\"c.md\", b\"x\", \"default\",