            "content": "// Incremental scan cache for CLI lint.\n//\n// Two-tier lookup to avoid reading files on cache hit:\n//   1. Fast path: stat(file) → check (path, mtime, size, ruleset_hash,\n//      profile, content_type, fix_mode) → return cached ScanOutput without\n//      reading the file.\n//   2. Slow path (mtime miss): read file, sha256, full cache key check.\n//\n// TTL-based expiry (default 24h) and MAX_ENTRIES cap prevent unbounded\n// growth.  Atomic writes via tempfile+rename.\n//\n// MCP path does NOT use this cache (stateless by design).\n// Shared infrastructure with 33.3 hook cache (same storage dir, same\n// sha256 hashing via audit::sha256_hex).\n\nuse std::collections::HashMap;\nuse std::path::{Path, PathBuf};\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::audit::sha256_hex;\nuse crate::engine::scan::ScanOutput;\n\n/// Default TTL in seconds (24 hours).\nconst DEFAULT_TTL_SECS: u64 = 24 * 60 * 60;\n\n/// Maximum number of cached entries.  Prevents unbounded growth when\n/// scanning large monorepos.  Oldest entries evicted first on overflow.\nconst MAX_ENTRIES: usize = 2000;\n\n/// Filesystem metadata used for the fast-path cache check.\n/// Avoids reading the file and computing sha256 when mtime+size match.\n#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\nstruct FileMeta {\n    mtime_secs: u64,\n    size: u64,\n}\n\n/// Scan parameters that affect output (excluding file content).\n#[derive(Debug, Clone, Hash, PartialEq, Eq, Serialize, Deserialize)]\nstruct ScanParams {\n    ruleset_hash: String,\n    profile: String,\n    content_type: String,\n    // Currently always \"None\" because caching is disabled when fix_mode\n    // is active.  Kept for forward-compatibility.\n    fix_mode: String,\n}\n\n/// A single cached entry.\n#[derive(Debug, Clone, Serialize, Deserialize)]\nstruct CacheEntry {\n    file_path: String,\n    content_hash: String,\n    file_meta: FileMeta,\n    params: ScanParams,\n    output: ScanOutput,\n    timestamp_secs: u64,\n}\n\n/// Persistent scan cache backed by a JSON file.\n#[derive(Debug)]\npub struct ScanCache {\n    path: PathBuf,\n    entries: HashMap<String, CacheEntry>,\n    ttl_secs: u64,\n    dirty: bool,\n}\n\n/// Result of a cache lookup.\npub enum CacheResult {\n    /// Fast-path hit: mtime+size match, no file read needed.\n    Hit(ScanOutput),\n    /// mtime changed or no entry: caller must read file and call `check_content`.\n    Miss,\n}\n\nimpl ScanCache {\n    /// Open (or create) the scan cache at the default location.\n    pub fn open_default() -> Self {\n        Self::open(default_cache_path())\n    }\n\n    /// Open (or create) the scan cache at a specific path.\n    pub fn open(path: PathBuf) -> Self {\n        let entries = load_entries(&path, DEFAULT_TTL_SECS);\n        ScanCache {\n            path,\n            entries,\n            ttl_secs: DEFAULT_TTL_SECS,\n            dirty: false,\n        }\n    }\n\n    /// Fast-path lookup using filesystem metadata (mtime + size).\n    /// Avoids reading the file when metadata matches.\n    pub fn check_fast(\n        &self,\n        file_path: &str,\n        mtime_secs: u64,\n        size: u64,\n        ruleset_hash: &str,\n        profile: &str,\n        content_type: &str,\n        fix_mode: &str,\n    ) -> CacheResult {\n        let lookup = fast_key(file_path, ruleset_hash, profile, content_type, fix_mode);\n        if let Some(entry) = self.entries.get(&lookup) {\n            let now = now_secs();\n            if now.saturating_sub(entry.timestamp_secs) <= self.ttl_secs\n                && entry.file_meta.mtime_secs == mtime_secs\n                && entry.file_meta.size == size\n            {\n                return CacheResult::Hit(entry.output.clone());\n            }\n        }\n        CacheResult::Miss\n    }\n\n    /// Slow-path lookup using content hash.  Called after file is read.\n    /// Returns cached output if content hash matches (mtime changed but\n    /// content didn't, e.g. after `touch`).\n    pub fn check_content(\n        &self,\n        file_path: &str,\n        content: &[u8],\n        ruleset_hash: &str,\n        profile: &str,\n        content_type: &str,\n        fix_mode: &str,\n    ) -> Option<ScanOutput> {\n        let lookup = fast_key(file_path, ruleset_hash, profile, content_type, fix_mode);\n        let entry = self.entries.get(&lookup)?;\n        let now = now_secs();\n        if now.saturating_sub(entry.timestamp_secs) > self.ttl_secs {\n            return None;\n        }\n        let hash = sha256_hex(content);\n        if entry.content_hash == hash {\n            Some(entry.output.clone())\n        } else {\n            None\n        }\n    }\n\n    /// Store a scan result in the cache.\n    pub fn put(\n        &mut self,\n        file_path: &str,\n        content: &[u8],\n        mtime_secs: u64,\n        size: u64,\n        ruleset_hash: &str,\n        profile: &str,\n        content_type: &str,\n        fix_mode: &str,\n        output: ScanOutput,\n    ) {\n        let lookup = fast_key(file_path, ruleset_hash, profile, content_type, fix_mode);\n        self.entries.insert(\n            lookup,\n            CacheEntry {\n                file_path: file_path.to_owned(),\n                content_hash: sha256_hex(content),\n                file_meta: FileMeta { mtime_secs, size },\n                params: ScanParams {\n                    ruleset_hash: ruleset_hash.to_owned(),\n                    profile: profile.to_owned(),\n                    content_type: content_type.to_owned(),\n                    fix_mode: fix_mode.to_owned(),\n                },\n                output,\n                timestamp_secs: now_secs(),\n            },\n        );\n        self.dirty = true;\n    }\n\n    /// Flush dirty cache to disk.  Prunes expired and overflow entries\n    /// before writing.  Uses tempfile + rename for atomic writes.\n    /// Errors are silently ignored (cache is best-effort).\n    pub fn flush(&mut self) {\n        if !self.dirty {\n            return;\n        }\n        // Prune expired entries.\n        let now = now_secs();\n        let ttl = self.ttl_secs;\n        self.entries\n            .retain(|_, e| now.saturating_sub(e.timestamp_secs) <= ttl);\n\n        // Evict oldest entries if over the cap.\n        if self.entries.len() > MAX_ENTRIES {\n            let mut by_time: Vec<(String, u64)> = self\n                .entries\n                .iter()\n                .map(|(k, e)| (k.clone(), e.timestamp_secs))\n                .collect();\n            by_time.sort_by_key(|(_, ts)| *ts);\n            let to_remove = self.entries.len() - MAX_ENTRIES;\n            for (k, _) in by_time.into_iter().take(to_remove) {\n                self.entries.remove(&k);\n            }\n        }\n\n        let Some(parent) = self.path.parent() else {\n            return;\n        };\n        let _ = std::fs::create_dir_all(parent);\n\n        // Atomic write: tempfile in same directory + rename.\n        let entries_vec: Vec<&CacheEntry> = self.entries.values().collect();\n        let Ok(json) = serde_json::to_vec(&entries_vec) else {\n            return;\n        };\n        let Ok(tmp) = tempfile::NamedTempFile::new_in(parent) else {\n            return;\n        };\n        if std::fs::write(tmp.path(), json).is_ok() {\n            let _ = tmp.persist(&self.path);\n        }\n        self.dirty = false;\n    }\n}\n\nimpl Drop for ScanCache {\n    fn drop(&mut self) {\n        self.flush();\n    }\n}\n\n/// Default cache file location: ~/.cache/zhtw-mcp/scan-cache.json\nfn default_cache_path() -> PathBuf {\n    cache_dir().join(\"zhtw-mcp\").join(\"scan-cache.json\")\n}\n\n/// Best-effort cache directory resolution without adding a dependency.\nfn cache_dir() -> PathBuf {\n    if let Ok(xdg) = std::env::var(\"XDG_CACHE_HOME\") {\n        if !xdg.is_empty() {\n            return PathBuf::from(xdg);\n        }\n    }\n    if let Ok(home) = std::env::var(\"HOME\") {\n        return PathBuf::from(home).join(\".cache\");\n    }\n    PathBuf::from(\"/tmp\")\n}\n\n/// Lookup key combining file path + scan parameters.\n/// One entry per (file, params) tuple — mtime/content validated on lookup.\nfn fast_key(\n    file_path: &str,\n    ruleset_hash: &str,\n    profile: &str,\n    content_type: &str,\n    fix_mode: &str,\n) -> String {\n    let composite = format!(\"{file_path}\\0{ruleset_hash}\\0{profile}\\0{content_type}\\0{fix_mode}\");\n    sha256_hex(composite.as_bytes())\n}\n\n/// Extract mtime (seconds since epoch) from filesystem metadata.\npub fn mtime_secs(meta: &std::fs::Metadata) -> u64 {\n    meta.modified()\n        .ok()\n        .and_then(|t| t.duration_since(UNIX_EPOCH).ok())\n        .map_or(0, |d| d.as_secs())\n}\n\nfn now_secs() -> u64 {\n    SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_secs()\n}\n\nfn load_entries(path: &Path, ttl_secs: u64) -> HashMap<String, CacheEntry> {\n    let bytes = match std::fs::read(path) {\n        Ok(b) => b,\n        Err(_) => return HashMap::new(),\n    };\n    let entries: Vec<CacheEntry> = match serde_json::from_slice(&bytes) {\n        Ok(v) => v,\n        Err(_) => return HashMap::new(),\n    };\n    let now = now_secs();\n    entries\n        .into_iter()\n        .filter(|e| now.saturating_sub(e.timestamp_secs) <= ttl_secs)\n        .map(|e| {\n            let key = fast_key(\n                &e.file_path,\n                &e.params.ruleset_hash,\n                &e.params.profile,\n                &e.params.content_type,\n                &e.params.fix_mode,\n            );\n            (key, e)\n        })\n        .collect()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::engine::scan::ScanOutput;\n    use crate::engine::zhtype::ChineseType;\n    use tempfile::TempDir;\n\n    fn empty_output() -> ScanOutput {\n        ScanOutput {\n            issues: vec![],\n            detected_script: ChineseType::Traditional,\n        }\n    }\n\n    #[test]\n    fn fast_path_hit() {\n        let dir = TempDir::new().unwrap();\n        let mut cache = ScanCache::open(dir.path().join(\"c.json\"));\n\n        cache.put(\"a.md\", b\"hello\", 1000, 5, \"rh\", \"default\", \"md\", \"none\", empty_output());\n\n        // Same mtime+size = fast hit.\n        assert!(matches!(\n            cache.check_fast(\"a.md\", 1000, 5, \"rh\", \"default\", \"md\", \"none\"),\n            CacheResult::Hit(_)\n        ));\n\n        // Different mtime = miss.\n        assert!(matches!(\n            cache.check_fast(\"a.md\", 2000, 5, \"rh\", \"default\", \"md\", \"none\"),\n            CacheResult::Miss\n        ));\n\n        // Different size = miss.\n        assert!(matches!(\n            cache.check_fast(\"a.md\", 1000, 99, \"rh\", \"default\", \"md\", \"none\"),\n            CacheResult::Miss\n        ));\n\n        // Different profile = miss (different entry entirely).\n        assert!(matches!(\n            cache.check_fast(\"a.md\", 1000, 5, \"rh\", \"strict\", \"md\", \"none\"),\n            CacheResult::Miss\n        ));\n    }\n\n    #[test]\n    fn slow_path_content_check() {\n        let dir = TempDir::new().unwrap();\n        let mut cache = ScanCache::open(dir.path().join(\"c.json\"));\n\n        cache.put(\"b.md\", b\"data\", 1000, 4, \"rh\", \"default\", \"plain\", \"none\", empty_output());\n\n        // Same content despite mtime miss: slow-path hit.\n        assert!(cache\n            .check_content(\"b.md\", b\"data\", \"rh\", \"default\", \"plain\", \"none\")\n            .is_some());\n\n        // Different content: slow-path miss.\n        assert!(cache\n            .check_content(\"b.md\", b\"changed\", \"rh\", \"default\", \"plain\", \"none\")\n            .is_none());\n    }\n\n    #[test]\n    fn cache_persists_to_disk() {\n        let dir = TempDir::new().unwrap();\n        let path = dir.path().join(\"c.json\");\n\n        {\n            let mut cache = ScanCache::open(path.clone());\n            cache.put(\"f.md\", b\"x\", 100, 1, \"rh\", \"default\", \"plain\", \"none\", empty_output());\n            cache.flush();\n        }\n\n        let cache = ScanCache::open(path);\n        assert!(matches!(\n            cache.check_fast(\"f.md\", 100, 1, \"rh\", \"default\", \"plain\", \"none\"),\n            CacheResult::Hit(_)\n        ));\n    }\n\n    #[test]\n    fn expired_entries_pruned() {\n        let dir = TempDir::new().unwrap();\n        let mut cache = ScanCache::open(dir.path().join(\"c.json\"));\n        cache.put(\"e.md\", b\"x\", 100, 1, \"rh\", \"default\", \"plain\", \"none\", empty_output());\n        for entry in cache.entries.values_mut() {\n            entry.timestamp_secs = 0;\n        }\n        assert!(matches!(\n            cache.check_fast(\"e.md\", 100, 1, \"rh\", \"default\", \"plain\", \"none\"),\n            CacheResult::Miss\n        ));\n    }\n\n    #[test]\n    fn overflow_evicts_oldest() {\n        let dir = TempDir::new().unwrap();\n        let mut cache = ScanCache::open(dir.path().join(\"c.json\"));\n\n        for i in 0..MAX_ENTRIES + 10 {\n            let name = format!(\"file_{i}.md\");\n            cache.put(&name, b\"x\", 100, 1, \"rh\", \"default\", \"plain\", \"none\", empty_output());\n            let key = fast_key(&name, \"rh\", \"default\", \"plain\", \"none\");\n            if let Some(e) = cache.entries.get_mut(&key) {\n                e.timestamp_secs = i as u64 + 1_700_000_000;\n            }\n        }\n\n        assert!(cache.entries.len() > MAX_ENTRIES);\n        cache.flush();\n        assert!(cache.entries.len() <= MAX_ENTRIES);\n    }\n}\n",
