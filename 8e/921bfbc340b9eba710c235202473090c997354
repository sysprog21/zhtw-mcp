            "content": "// Per-profile token budget and cost modes (51.3).\n//\n// Three cost modes controlling how aggressively the system uses LLM sampling:\n// - Economy:      zero LLM calls, deterministic + heuristic only.\n// - Balanced:     LLM only for Tier 2 gray-zone issues (default).\n// - MaxAccuracy:  widened gray-zone net, most terms enter Tier 3.\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::rules::ruleset::Profile;\n\n/// Cost mode controlling LLM budget allocation.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum CostMode {\n    /// Token budget = 0.  Deterministic + heuristic only.\n    /// Suitable for CI, batch checks, ui_strings profile.\n    Economy,\n    /// LLM only for high-value ambiguous cases (Tier 2 gray zone).\n    /// Default for base and strict profiles.\n    Balanced,\n    /// Gray-zone threshold radically tightened, forcing the majority of\n    /// polysemous terms into Tier 3 with full confidence and detailed reasoning.\n    /// Default for editorial profile (future).\n    MaxAccuracy,\n}\n\nimpl CostMode {\n    /// Canonical string name for JSON output.\n    pub fn name(self) -> &'static str {\n        match self {\n            CostMode::Economy => \"economy\",\n            CostMode::Balanced => \"balanced\",\n            CostMode::MaxAccuracy => \"max_accuracy\",\n        }\n    }\n\n    /// Parse from string, returning None for unknown values.\n    pub fn from_str(s: &str) -> Option<Self> {\n        match s {\n            \"economy\" => Some(CostMode::Economy),\n            \"balanced\" => Some(CostMode::Balanced),\n            \"max_accuracy\" => Some(CostMode::MaxAccuracy),\n            _ => None,\n        }\n    }\n\n    /// Default cost mode for a given profile.\n    pub fn default_for_profile(profile: Profile) -> Self {\n        match profile {\n            Profile::Base | Profile::Strict => CostMode::Balanced,\n        }\n    }\n\n    /// Whether LLM sampling is allowed under this cost mode.\n    pub fn allows_sampling(self) -> bool {\n        !matches!(self, CostMode::Economy)\n    }\n\n    /// Tier 2 threshold adjustments for this cost mode.\n    /// Returns (decided_threshold, ambiguous_threshold).\n    pub fn disambig_thresholds(self) -> (f32, f32) {\n        match self {\n            // Economy: thresholds irrelevant (no LLM), but set decided=0.3\n            // so more issues resolve locally instead of entering gray zone.\n            CostMode::Economy => (0.3, 0.3),\n            // Balanced: default thresholds.\n            CostMode::Balanced => (0.6, 0.3),\n            // MaxAccuracy: tighten decided threshold so more terms enter gray zone\n            // (and thus Tier 3). Raise ambiguous too, to keep fewer suppressions.\n            CostMode::MaxAccuracy => (0.8, 0.15),\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn parse_round_trips() {\n        for mode in [CostMode::Economy, CostMode::Balanced, CostMode::MaxAccuracy] {\n            assert_eq!(CostMode::from_str(mode.name()), Some(mode));\n        }\n    }\n\n    #[test]\n    fn economy_disallows_sampling() {\n        assert!(!CostMode::Economy.allows_sampling());\n        assert!(CostMode::Balanced.allows_sampling());\n        assert!(CostMode::MaxAccuracy.allows_sampling());\n    }\n\n    #[test]\n    fn default_profiles() {\n        assert_eq!(\n            CostMode::default_for_profile(Profile::Base),\n            CostMode::Balanced\n        );\n        assert_eq!(\n            CostMode::default_for_profile(Profile::Strict),\n            CostMode::Balanced\n        );\n    }\n\n    #[test]\n    fn max_accuracy_widens_gray_zone() {\n        let (decided_b, ambig_b) = CostMode::Balanced.disambig_thresholds();\n        let (decided_m, ambig_m) = CostMode::MaxAccuracy.disambig_thresholds();\n        // MaxAccuracy: higher decided threshold = fewer local resolutions\n        assert!(decided_m > decided_b);\n        // MaxAccuracy: lower ambiguous threshold = fewer suppressions\n        assert!(ambig_m < ambig_b);\n    }\n\n    #[test]\n    fn economy_thresholds_collapse() {\n        let (decided, ambig) = CostMode::Economy.disambig_thresholds();\n        // decided == ambiguous: no gray zone, everything resolves or suppresses\n        assert_eq!(decided, ambig);\n    }\n}\n",
