            "content": "// Incremental scan cache for CLI lint.\n//\n// Caches ScanOutput keyed on (file_path, content_hash, ruleset_hash,\n// profile, content_type, fix_mode).  Skips the entire scan pipeline on\n// cache hit.  TTL-based expiry (default 24h) prevents unbounded growth.\n// Entry count capped at MAX_ENTRIES to bound memory and disk usage.\n//\n// MCP path does NOT use this cache (stateless by design).\n// Shared infrastructure with 33.3 hook cache (same storage dir, same\n// sha256 hashing via audit::sha256_hex).\n//\n// Concurrency: flush uses tempfile + rename for atomic writes, preventing\n// corruption from concurrent CLI invocations.  Lost updates between\n// concurrent writers are tolerated (best-effort cache, not a database).\n\nuse std::collections::HashMap;\nuse std::path::{Path, PathBuf};\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::audit::sha256_hex;\nuse crate::engine::scan::ScanOutput;\n\n/// Default TTL in seconds (24 hours).\nconst DEFAULT_TTL_SECS: u64 = 24 * 60 * 60;\n\n/// Maximum number of cached entries.  Prevents unbounded growth when\n/// scanning large monorepos.  Oldest entries evicted first on overflow.\nconst MAX_ENTRIES: usize = 2000;\n\n/// Parameters that uniquely identify a scan invocation for caching.\npub struct ScanCacheKey<'a> {\n    pub file_path: &'a str,\n    pub content: &'a [u8],\n    pub ruleset_hash: &'a str,\n    pub profile: &'a str,\n    pub content_type: &'a str,\n    // Currently always \"None\" because caching is disabled when fix_mode\n    // is active.  Kept in the key for forward-compatibility if fix result\n    // caching is added later.\n    pub fix_mode: &'a str,\n}\n\n/// Internal cache key with content hash (not raw content).\n#[derive(Debug, Clone, Hash, PartialEq, Eq, Serialize, Deserialize)]\nstruct StoredKey {\n    file_path: String,\n    content_hash: String,\n    ruleset_hash: String,\n    profile: String,\n    content_type: String,\n    fix