  pub fn open(path: PathBuf) -> Self {\n        let entries = load_entries(&path);\n        ScanCache {\n            path,\n            entries,\n            ttl_secs: DEFAULT_TTL_SECS,\n            dirty: false,\n        }\n    }\n\n    /// Look up a cached scan result.  Returns None on cache miss or expired entry.\n    pub fn get(&self, params: &ScanCacheKey<'_>) -> Option<&ScanOutput> {\n        let stored = to_stored_key(params);\n        let hash = entry_hash(&stored);\n        let entry = self.entries.get(&hash)?;\n        let now = now_secs();\n        if now.saturating_sub(entry.timestamp_secs) > self.ttl_secs {\n            return None;\n        }\n        Some(&entry.output)\n    }\n\n    /// Store a scan result in the cache.\n    pub fn put(&mut self, params: &ScanCacheKey<'_>, output: ScanOutput) {\n        let stored = to_stored_key(params);\n        let hash = entry_hash(&stored);\n        self.entries.insert(\n            hash,\n            CacheEntry {\n                key: stored,\n                output,\n                timestamp_secs: now_secs(),\n            },\n        );\n        self.dirty = true;\n    }\n\n    /// Flush dirty cache to disk.  Prunes expired entries before writing.\n    /// Errors are silently ignored (cache is best-effort).\n    pub fn flush(&mut self) {\n        if !self.dirty {\n            return;\n        }\n        // Prune expired entries.\n        let now = now_secs();\n        let ttl = self.ttl_secs;\n        self.entries\n            .retain(|_, e| now.saturating_sub(e.timestamp_secs) <= ttl);\n\n        if let Some(parent) = self.path.parent() {\n            let _ = std::fs::create_dir_all(parent);\n        }\n        let entries_vec: Vec<&CacheEntry> = self.entries.values().collect();\n        if let Ok(json) = serde_json::to_vec(&entries_vec) {\n            let _ = std::fs::write(&self.path, json);\n        }\n        self.dirty = false;\n    }\n}\n\nimpl Drop for ScanCache {\n    fn drop(&mut self) {\n        self.flush();\n    }\n}\n\n/// Default cache file location: ~/.cache/zhtw-mcp/scan-cache.json\nfn default_cache_path() -> PathBuf {\n    cache_dir().join(\"zhtw-mcp\").join(\"scan-cache.json\")\n}\n\n/// Best-effort cache directory resolution without adding a dependency.\nfn cache_dir() -> PathBuf {\n    if let Ok(xdg) = std::env::var(\"XDG_CACHE_HOME\") {\n        if !xdg.is_empty() {\n            return PathBuf::from(xdg);\n        }\n    }\n    if let Ok(home) = std::env::var(\"HOME\") {\n        return PathBuf::from(home).join(\".cache\");\n    }\n    PathBuf::from(\"/tmp\")\n}\n\nfn to_stored_key(params: &ScanCacheKey<'_>) -> StoredKey {\n    StoredKey {\n        file_path: params.file_path.to_owned(),\n        content_hash: sha256_hex(params.content),\n        ruleset_hash: params.ruleset_hash.to_owned(),\n        profile: params.profile.to_owned(),\n        content_type: params.content_type.to_owned(),\n        fix_mode: params.fix_mode.to_owned(),\n    }\n}\n\nfn entry_hash(key: &StoredKey) -> String {\n    let composite = format!(\n        \"{}|{}|{}|{}|{}|{}\",\n        key.file_path, key.content_hash, key.ruleset_hash, key.profile, key.content_type,\n        key.fix_mode\n    );\n    sha256_hex(composite.as_bytes())\n}\n\nfn now_secs() -> u64 {\n    SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_secs()\n}\n\nfn load_entries(path: &Path) -> HashMap<String, CacheEntry> {\n    let bytes = match std::fs::read(path) {\n        Ok(b) => b,\n        Err(_) => return HashMap::new(),\n    };\n    let entries: Vec<CacheEntry> = match serde_json::from_slice(&bytes) {\n        Ok(v) => v,\n        Err(_) => return HashMap::new(),\n    };\n    let now = now_secs();\n    entries\n        .into_iter()\n        .filter(|e| now.saturating_sub(e.timestamp_secs) <= DEFAULT_TTL_SECS)\n        .map(|e| (entry_hash(&e.key), e))\n        .collect()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::engine::scan::S