            "content": "// Incremental scan cache for CLI lint.\n//\n// Caches ScanOutput keyed on (file_path, content_hash, ruleset_hash,\n// profile, content_type, fix_mode).  Skips the entire scan pipeline on\n// cache hit.  TTL-based expiry (default 24h) prevents unbounded growth.\n//\n// MCP path does NOT use this cache (stateless by design).\n// Shared infrastructure with 33.3 hook cache (same storage dir, same\n// sha256 hashing via audit::sha256_hex).\n\nuse std::collections::HashMap;\nuse std::path::{Path, PathBuf};\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::audit::sha256_hex;\nuse crate::engine::scan::ScanOutput;\n\n/// Default TTL in seconds (24 hours).\nconst DEFAULT_TTL_SECS: u64 = 24 * 60 * 60;\n\n/// Parameters that uniquely identify a scan invocation for caching.\npub struct ScanCacheKey<'a> {\n    pub file_path: &'a str,\n    pub content: &'a [u8],\n    pub ruleset_hash: &'a str,\n    pub profile: &'a str,\n    pub content_type: &'a str,\n    pub fix_mode: &'a str,\n}\n\n/// Internal cache key with content hash (not raw content).\n#[derive(Debug, Clone, Hash, PartialEq, Eq, Serialize, Deserialize)]\nstruct StoredKey {\n    file_path: String,\n    content_hash: String,\n    ruleset_hash: String,\n    profile: String,\n    content_type: String,\n    fix_mode: String,\n}\n\n/// A single cached entry with timestamp for TTL expiry.\n#[derive(Debug, Clone, Serialize, Deserialize)]\nstruct CacheEntry {\n    key: StoredKey,\n    output: ScanOutput,\n    timestamp_secs: u64,\n}\n\n/// Persistent scan cache backed by a JSON file.\n#[derive(Debug)]\npub struct ScanCache {\n    path: PathBuf,\n    entries: HashMap<String, CacheEntry>,\n    ttl_secs: u64,\n    dirty: bool,\n}\n\nimpl ScanCache {\n    /// Open (or create) the scan cache at the default location.\n    pub fn open_default() -> Self {\n        Self::open(default_cache_path())\n    }\n\n    /// Open (or create) the scan cache at a specific path.\n    pub fn open(path: PathBuf) -> Self {\n        let entries = load_entries(&path);\n        ScanCache {\n            path,\n            entries,\n            ttl_secs: DEFAULT_TTL_SECS,\n            dirty: false,\n        }\n    }\n\n    /// Look up a cached scan result.  Returns None on cache miss or expired entry.\n    pub fn get(&self, params: &ScanCacheKey<'_>) -> Option<&ScanOutput> {\n        let stored = to_stored_key(params);\n        let hash = entry_hash(&stored);\n        let entry = self.entries.get(&hash)?;\n        let now = now_secs();\n        if now.saturating_sub(entry.timestamp_secs) > self.ttl_secs {\n            return None;\n        }\n        Some(&entry.output)\n    }\n\n    /// Store a scan result in the cache.\n    pub fn put(&mut self, params: &ScanCacheKey<'_>, output: ScanOutput) {\n        let stored = to_stored_key(params);\n        let hash = entry_hash(&stored);\n        self.entries.insert(\n            hash,\n            CacheEntry {\n                key: stored,\n                output,\n                timestamp_secs: now_secs(),\n            },\n        );\n        self.dirty = true;\n    }\n\n    /// Flush dirty cache to disk.  Prunes expired entries before writing.\n    /// Errors are silently ignored (cache is best-effort).\n    pub fn flush(&mut self) {\n        if !self.dirty {\n            return;\n        }\n        // Prune expired entries.\n        let now = now_secs();\n        let ttl = self.ttl_secs;\n        self.entries\n            .retain(|_, e| now.saturating_sub(e.timestamp_secs) <= ttl);\n\n        if let Some(parent) = self.path.parent() {\n            let _ = std::fs::create_dir_all(parent);\n        }\n        let entries_vec: Vec<&CacheEntry> = self.entries.values().collect();\n        if let Ok(json) = serde_json::to_vec(&entries_vec) {\n            let _ = std::fs::write(&self.path, json);\n        }\n        self.dirty = false;\n    }\n}\n\nimpl Drop for ScanCache {\n    fn drop(&mut self) {\n        se