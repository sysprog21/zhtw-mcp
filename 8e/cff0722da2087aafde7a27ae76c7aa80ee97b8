&'a str,\n        ct: &'a str,\n    ) -> ScanCacheKey<'a> {\n        ScanCacheKey {\n            file_path: file,\n            content,\n            ruleset_hash: \"rh\",\n            profile,\n            content_type: ct,\n            fix_mode: \"none\",\n        }\n    }\n\n    #[test]\n    fn cache_hit_and_miss() {\n        let dir = TempDir::new().unwrap();\n        let path = dir.path().join(\"cache.json\");\n        let mut cache = ScanCache::open(path);\n\n        let k = key(\"a.md\", b\"hello\", \"default\", \"markdown\");\n        assert!(cache.get(&k).is_none());\n\n        cache.put(&k, empty_output());\n        assert!(cache.get(&k).is_some());\n\n        // Different content = miss.\n        let k2 = key(\"a.md\", b\"world\", \"default\", \"markdown\");\n        assert!(cache.get(&k2).is_none());\n\n        // Different profile = miss.\n        let k3 = key(\"a.md\", b\"hello\", \"strict_moe\", \"markdown\");\n        assert!(cache.get(&k3).is_none());\n    }\n\n    #[test]\n    fn cache_persists_to_disk() {\n        let dir = TempDir::new().unwrap();\n        let path = dir.path().join(\"cache.json\");\n\n        {\n            let mut cache = ScanCache::open(path.clone());\n            cache.put(&key(\"b.md\", b\"data\", \"default\", \"plain\"), empty_output());\n            cache.flush();\n        }\n\n        let cache = ScanCache::open(path);\n        assert!(cache\n            .get(&key(\"b.md\", b\"data\", \"default\", \"plain\"))\n            .is_some());\n    }\n\n    #[test]\n    fn expired_entries_pruned() {\n        let dir = TempDir::new().unwrap();\n        let path = dir.path().join(\"cache.json\");\n        let mut cache = ScanCache::open(path);\n        cache.put(&key(\"c.md\", b\"x\", \"default\", \"plain\"), empty_output());\n        // Backdate the entry to force expiry.\n        for entry in cache.entries.values_mut() {\n            entry.timestamp_secs = 0;\n        }\n        assert!(cache.get(&key(\"c.md\", b\"x\", \"default\",