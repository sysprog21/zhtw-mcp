            "content": "// Per-starter bitmask gating for DAAC post-filter.\n//\n// Sparse hash map storing (mask, cap) per starter character.  Prunes\n// impossible (starter, char-length) pairs before predicate IR evaluation.\n// Bit N in a starter's mask means a pattern of char-length N+1 exists\n// starting with that character.\n//\n// Inspired by opencc-fmmseg StarterUnion (externals/opencc-fmmseg).\n// Uses a unified sparse map instead of BMP dense arrays -- the actual\n// starter count (~600) makes dense [u64; 65536] wasteful (576 KB vs ~20 KB).\n\nuse rustc_hash::FxHashMap;\n\n/// Pre-computed bitmask lookup for (starter-char, char-length) filtering.\n///\n/// For each starter character that begins at least one spelling pattern,\n/// stores a `u64` bitmask where bit N means a pattern of char-length N+1\n/// exists, plus a `u8` max-length cap.\npub struct StarterUnion {\n    // (mask, cap) per starter character.  ~596 entries for the current\n    // ruleset, ~20 KB total vs 576 KB for dense BMP arrays.\n    map: FxHashMap<char, (u64, u8)>,\n}\n\nimpl StarterUnion {\n    /// Build from an iterator of patterns (the `from` strings of spelling rules).\n    ///\n    /// Each pattern contributes its first character as a starter and its\n    /// char-length as a bit in that starter's mask.\n    pub fn build<'a>(patterns: impl Iterator<Item = &'a str>) -> Self {\n        let mut map: FxHashMap<char, (u64, u8)> = FxHashMap::default();\n\n        for pat in patterns {\n            let mut chars = pat.chars();\n            let Some(starter) = chars.next() else {\n                continue;\n            };\n            let char_len = 1 + chars.count();\n            let bit = length_to_bit(char_len);\n            let cap = char_len.min(255) as u8;\n\n            let entry = map.entry(starter).or_insert((0, 0));\n            entry.0 |= bit;\n            if cap > entry.1 {\n                entry.1 = cap;\n            }\n        }\n\n        Self { map }\n    }\n\n    /// Check whether any pattern starts with `starter` and has char-length\n    /// `char_len`.  Returns `true` if the (starter, char_len) pair is\n    /// possible, meaning predicate evaluation should proceed.\n    ///\n    /// For char-lengths > 64, falls through to a max-length cap check\n    /// (individual bits are not tracked beyond 64).\n    #[inline]\n    pub fn can_match(&self, starter: char, char_len: usize) -> bool {\n        if char_len == 0 {\n            return false;\n        }\n\n        let Some(&(mask, cap)) = self.map.get(&starter) else {\n            return false;\n        };\n\n        // Max-length cap prunes oversized matches.\n        if char_len > cap as usize {\n            return false;\n        }\n\n        let bit = length_to_bit(char_len);\n        // bit == 0 means char_len > 64; fall through (cap already checked).\n        bit == 0 || (mask & bit) != 0\n    }\n\n    /// Build an empty StarterUnion (rejects everything).\n    pub fn empty() -> Self {\n        Self {\n            map: FxHashMap::default(),\n        }\n    }\n}\n\nimpl std::fmt::Debug for StarterUnion {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.debug_struct(\"StarterUnion\")\n            .field(\"starters\", &self.map.len())\n            .finish()\n    }\n}\n\n/// Convert a char-length to its bitmask bit.\n/// Returns 0 for lengths > 64 (caller must fall through to cap check).\n#[inline]\nfn length_to_bit(char_len: usize) -> u64 {\n    if char_len == 0 || char_len > 64 {\n        0\n    } else {\n        1u64 << (char_len - 1)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn basic_bitmask() {\n        let patterns = [\"hello\", \"hi\", \"好的\", \"好\"];\n        let union = StarterUnion::build(patterns.iter().copied());\n\n        // 'h' starter: lengths 5 (hello) and 2 (hi)\n        assert!(union.can_match('h', 5));\n        assert!(union.can_match('h', 2));\n        assert!(!union.can_match('h', 3));\n        assert!(!union.can_match('h', 1));\n\n        // '好' starter: lengths 2 (好的) and 1 (好)\n        assert!(union.can_match('好', 2));\n        assert!(union.can_match('好', 1));\n        assert!(!union.can_match('好', 3));\n\n        // Unknown starter\n        assert!(!union.can_match('z', 1));\n    }\n\n    #[test]\n    fn zero_length_rejected() {\n        let patterns = [\"a\"];\n        let union = StarterUnion::build(patterns.iter().copied());\n        assert!(!union.can_match('a', 0));\n    }\n\n    #[test]\n    fn empty_pattern_skipped() {\n        let patterns = [\"\", \"a\"];\n        let union = StarterUnion::build(patterns.iter().copied());\n        assert!(union.can_match('a', 1));\n        assert!(!union.can_match('\\0', 0));\n    }\n\n    #[test]\n    fn cap_prunes_long() {\n        let patterns = [\"ab\", \"abc\"];\n        let union = StarterUnion::build(patterns.iter().copied());\n        assert!(!union.can_match('a', 4));\n        assert!(!union.can_match('a', 100));\n    }\n\n    #[test]\n    fn empty_union_rejects_all() {\n        let union = StarterUnion::empty();\n        assert!(!union.can_match('a', 1));\n        assert!(!union.can_match('好', 2));\n    }\n\n    #[test]\n    fn long_pattern_over_64_chars() {\n        let long: String = std::iter::repeat('x').take(70).collect();\n        let patterns = [long.as_str()];\n        let union = StarterUnion::build(patterns.iter().copied());\n\n        assert!(union.can_match('x', 70));\n        assert!(!union.can_match('x', 71));\n        // Cap-only fallback for >64: accepts any length <= cap.\n        assert!(union.can_match('x', 65));\n    }\n\n    #[test]\n    fn mixed_short_and_long_pattern() {\n        let long: String = std::iter::repeat('a').take(100).collect();\n        let patterns = [\"ab\", long.as_str()];\n        let union = StarterUnion::build(patterns.iter().copied());\n\n        assert!(union.can_match('a', 2));\n        assert!(!union.can_match('a', 3));\n        assert!(union.can_match('a', 100));\n        assert!(!union.can_match('a', 101));\n    }\n\n    #[test]\n    fn from_real_rules() {\n        use crate::rules::loader::load_embedded_ruleset;\n        let rs = load_embedded_ruleset().expect(\"load embedded ruleset\");\n        let union = StarterUnion::build(rs.spelling_rules.iter().map(|r| r.from.as_str()));\n\n        let cjk_active = (0x4E00u32..=0x9FFFu32)\n            .filter(|&cp| union.map.contains_key(&char::from_u32(cp).unwrap()))\n            .count();\n        assert!(cjk_active > 0, \"expected CJK starters in union\");\n\n        let entry_count = union.map.len();\n        assert!(\n            entry_count < 1000,\n            \"expected < 1000 starters, got {entry_count}\"\n        );\n    }\n}\n",
