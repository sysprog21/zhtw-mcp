            "content": "// Token reduction evaluation: measures tier distribution and LLM avoidance\n// across corpora and cost modes.\n//\n// NOT a pass/fail test — prints a report for human analysis.\n\nuse zhtw_mcp::engine::disambig::{disambiguate_batch, DisambigConfig, DisambigStats};\nuse zhtw_mcp::engine::s2t::S2TConverter;\nuse zhtw_mcp::engine::scan::{ContentType, Scanner};\nuse zhtw_mcp::mcp::cost_mode::CostMode;\nuse zhtw_mcp::rules::ruleset::Profile;\n\nfn load_scanner() -> (Scanner, S2TConverter) {\n    let ruleset = zhtw_mcp::rules::loader::load_embedded_ruleset().unwrap();\n    let scanner = Scanner::new(ruleset.spelling_rules, ruleset.case_rules);\n    (scanner, S2TConverter::new())\n}\n\nstruct TierReport {\n    corpus: String,\n    cost_mode: CostMode,\n    total_issues: usize,\n    not_eligible: usize,\n    hard_anchor: usize,\n    tier2_resolved: usize,\n    suppressed: usize,\n    gray_zone: usize,\n}\n\nimpl TierReport {\n    fn llm_avoidance_pct(&self) -> f64 {\n        let total_eligible =\n            self.hard_anchor + self.tier2_resolved + self.suppressed + self.gray_zone;\n        if total_eligible == 0 {\n            return 100.0;\n        }\n        let avoided = self.hard_anchor + self.tier2_resolved + self.suppressed;\n        (avoided as f64) / (total_eligible as f64) * 100.0\n    }\n}\n\nfn evaluate_text(\n    scanner: &Scanner,\n    s2t: &S2TConverter,\n    text: &str,\n    content_type: ContentType,\n    profile: Profile,\n    cost_mode: CostMode,\n    detect_ai: bool,\n) -> (usize, DisambigStats) {\n    let converted = if zhtw_mcp::engine::zhtype::detect_chinese_type(text)\n        == zhtw_mcp::engine::zhtype::ChineseType::Simplified\n    {\n        Some(s2t.convert(text))\n    } else {\n        None\n    };\n    let work_text = converted.as_deref().unwrap_or(text);\n\n    let mut cfg = profile.config();\n    if detect_ai {\n        cfg.ai_filler_detection = true;\n        cfg.ai_semantic_safety = true;\n        cfg.ai_density_detection = true;\n        cfg.ai_structural_patterns = true;\n    }\n\n    let scan_out = scanner.scan_for_content_type_with_config(work_text, content_type, cfg);\n    let mut issues = scan_out.issues;\n    let total = issues.len();\n\n    let (decided_th, ambig_th) = cost_mode.disambig_thresholds();\n    let disambig_cfg = DisambigConfig {\n        decided_threshold: decided_th,\n        ambiguous_threshold: ambig_th,\n        profile,\n    };\n    let stats = disambiguate_batch(&mut issues, work_text, &disambig_cfg);\n\n    (total, stats)\n}\n\nfn run_corpus_eval(\n    scanner: &Scanner,\n    s2t: &S2TConverter,\n    corpus_name: &str,\n    texts: &[&str],\n    content_type: ContentType,\n    profile: Profile,\n    detect_ai: bool,\n) -> Vec<TierReport> {\n    let modes = [CostMode::Economy, CostMode::Balanced, CostMode::MaxAccuracy];\n    let mut reports = Vec::new();\n\n    for &mode in &modes {\n        let mut agg_total = 0usize;\n        let mut agg = DisambigStats::default();\n\n        for text in texts {\n            let (total, stats) =\n                evaluate_text(scanner, s2t, text, content_type, profile, mode, detect_ai);\n            agg_total += total;\n            agg.not_eligible += stats.not_eligible;\n            agg.hard_anchor += stats.hard_anchor;\n            agg.tier2_resolved += stats.tier2_resolved;\n            agg.suppressed += stats.suppressed;\n            agg.gray_zone += stats.gray_zone;\n        }\n\n        reports.push(TierReport {\n            corpus: corpus_name.to_string(),\n            cost_mode: mode,\n            total_issues: agg_total,\n            not_eligible: agg.not_eligible,\n            hard_anchor: agg.hard_anchor,\n            tier2_resolved: agg.tier2_resolved,\n            suppressed: agg.suppressed,\n            gray_zone: agg.gray_zone,\n        });\n    }\n\n    reports\n}\n\nfn print_report(reports: &[TierReport]) {\n    eprintln!();\n    eprintln!(\n        \"{:<20} {:<14} {:>6} {:>8} {:>6} {:>8} {:>6} {:>6} {:>8}\",\n        \"Corpus\", \"CostMode\", \"Total\", \"NotElig\", \"Hard\", \"Tier2\", \"Supp\", \"Gray\", \"Avoid%\"\n    );\n    eprintln!(\"{}\", \"-\".repeat(98));\n    for r in reports {\n        eprintln!(\n            \"{:<20} {:<14} {:>6} {:>8} {:>6} {:>8} {:>6} {:>6} {:>7.1}%\",\n            r.corpus,\n            r.cost_mode.name(),\n            r.total_issues,\n            r.not_eligible,\n            r.hard_anchor,\n            r.tier2_resolved,\n            r.suppressed,\n            r.gray_zone,\n            r.llm_avoidance_pct(),\n        );\n    }\n    eprintln!();\n}\n\n// -- Corpus A: deterministic (pure Tier 1, no ambiguity) --------------------\n\n#[test]\nfn eval_deterministic_tier_distribution() {\n    let (scanner, s2t) = load_scanner();\n    let texts: Vec<&str> = vec![\n        \"用户可以在信息中查看软件的默认配置。\",\n        \"這是一個測試,請注意!\",\n        \"作業系統的記憶體管理模組已經最佳化。\",\n    ];\n    let reports = run_corpus_eval(\n        &scanner,\n        &s2t,\n        \"deterministic\",\n        &texts,\n        ContentType::Markdown,\n        Profile::Base,\n        false,\n    );\n    print_report(&reports);\n\n    // Gate: deterministic corpus must have zero gray zone across all modes.\n    for r in &reports {\n        assert_eq!(\n            r.gray_zone, 0,\n            \"deterministic corpus should have zero gray zone in {} mode\",\n            r.cost_mode.name()\n        );\n    }\n}\n\n// -- Corpus B: CN cross-strait (bulk terminology, Tier 2 battleground) ------\n\n#[test]\nfn eval_cross_strait_tier_distribution() {\n    let (scanner, s2t) = load_scanner();\n    let texts: Vec<&str> = vec![\n        \"該軟件模塊需要優化數據庫的性能，並把內存中的緩存數據同步到網絡節點。\",\n        \"操作系統提供鏈接檢查器，可分析進程記錄並生成日志文件。\",\n        \"服務器的默認配置需要更新，用戶可以通過網絡接口訪問相關信息。\",\n        \"視頻會議服務使用默認錄像模板，並在文檔頁面顯示錯誤消息。\",\n        \"該程序支持多線程併發處理和異步回調機制。\",\n    ];\n    let reports = run_corpus_eval(\n        &scanner,\n        &s2t,\n        \"cross_strait\",\n        &texts,\n        ContentType::Plain,\n        Profile::Base,\n        false,\n    );\n    print_report(&reports);\n\n    // Economy mode must have zero gray zone.\n    let econ = reports.iter().find(|r| r.cost_mode == CostMode::Economy).unwrap();\n    assert_eq!(econ.gray_zone, 0, \"economy must have zero gray zone\");\n\n    // MaxAccuracy should have >= gray zone than balanced.\n    let balanced = reports.iter().find(|r| r.cost_mode == CostMode::Balanced).unwrap();\n    let max_acc = reports.iter().find(|r| r.cost_mode == CostMode::MaxAccuracy).unwrap();\n    assert!(\n        max_acc.gray_zone >= balanced.gray_zone,\n        \"max_accuracy gray_zone ({}) should be >= balanced ({})\",\n        max_acc.gray_zone,\n        balanced.gray_zone,\n    );\n}\n\n// -- Corpus C: ambiguous terms (polysemous, context-dependent) --------------\n\n#[test]\nfn eval_ambiguous_tier_distribution() {\n    let (scanner, s2t) = load_scanner();\n    let texts: Vec<&str> = vec![\n        \"作業系統的進程排程器管理CPU執行緒分配。\",\n        \"GPU渲染引擎支持即時光線追蹤。\",\n        \"學習的進程需要耐心和毅力。\",\n        \"這個算法支持並行計算和分佈式處理。\",\n        \"用戶端口需要配置防火牆規則。\",\n    ];\n    let reports = run_corpus_eval(\n        &scanner,\n        &s2t,\n        \"ambiguous\",\n        &texts,\n        ContentType::Plain,\n        Profile::Base,\n        false,\n    );\n    print_report(&reports);\n}\n\n// -- Corpus D: mixed markdown (structural integrity) ------------------------\n\n#[test]\nfn eval_mixed_content_tier_distribution() {\n    let (scanner, s2t) = load_scanner();\n    let texts: Vec<&str> = vec![\n        \"```\\nconst x = 1;\\n```\\n\\n該軟件的默認配置需要更新。\",\n        \"使用 `malloc` 函数分配內存空間。\",\n        \"| 名稱 | 說明 |\\n|------|------|\\n| 記憶體 | 系統資源 |\",\n        \"安裝 Docker 容器並設定 MongoDB 資料庫。\",\n    ];\n    let reports = run_corpus_eval(\n        &scanner,\n        &s2t,\n        \"mixed_content\",\n        &texts,\n        ContentType::Markdown,\n        Profile::Base,\n        false,\n    );\n    print_report(&reports);\n}\n\n// -- Aggregated summary across all corpora ----------------------------------\n\n#[test]\nfn eval_token_reduction_summary() {\n    let (scanner, s2t) = load_scanner();\n\n    // Combine all corpus texts for aggregate measurement.\n    let all_texts: Vec<&str> = vec![\n        // Deterministic\n        \"用户可以在信息中查看软件的默认配置。\",\n        \"這是一個測試,請注意!\",\n        \"作業系統的記憶體管理模組已經最佳化。\",\n        // Cross-strait\n        \"該軟件模塊需要優化數據庫的性能，並把內存中的緩存數據同步到網絡節點。\",\n        \"操作系統提供鏈接檢查器，可分析進程記錄並生成日志文件。\",\n        \"服務器的默認配置需要更新，用戶可以通過網絡接口訪問相關信息。\",\n        \"視頻會議服務使用默認錄像模板，並在文檔頁面顯示錯誤消息。\",\n        \"該程序支持多線程併發處理和異步回調機制。\",\n        // Ambiguous\n        \"作業系統的進程排程器管理CPU執行緒分配。\",\n        \"GPU渲染引擎支持即時光線追蹤。\",\n        \"學習的進程需要耐心和毅力。\",\n        \"這個算法支持並行計算和分佈式處理。\",\n        \"用戶端口需要配置防火牆規則。\",\n        // Mixed\n        \"```\\nconst x = 1;\\n```\\n\\n該軟件的默認配置需要更新。\",\n        \"使用 `malloc` 函数分配內存空間。\",\n        \"| 名稱 | 說明 |\\n|------|------|\\n| 記憶體 | 系統資源 |\",\n        \"安裝 Docker 容器並設定 MongoDB 資料庫。\",\n    ];\n\n    let reports = run_corpus_eval(\n        &scanner,\n        &s2t,\n        \"AGGREGATE\",\n        &all_texts,\n        ContentType::Markdown,\n        Profile::Base,\n        false,\n    );\n\n    eprintln!();\n    eprintln!(\"=== TOKEN REDUCTION SUMMARY ===\");\n    print_report(&reports);\n\n    let balanced = reports.iter().find(|r| r.cost_mode == CostMode::Balanced).unwrap();\n    let economy = reports.iter().find(|r| r.cost_mode == CostMode::Economy).unwrap();\n    let max_acc = reports.iter().find(|r| r.cost_mode == CostMode::MaxAccuracy).unwrap();\n\n    eprintln!(\"Key findings:\");\n    eprintln!(\n        \"  Balanced: {:.1}% of eligible issues resolved without LLM ({} of {} eligible)\",\n        balanced.llm_avoidance_pct(),\n        balanced.hard_anchor + balanced.tier2_resolved + balanced.suppressed,\n        balanced.hard_anchor + balanced.tier2_resolved + balanced.suppressed + balanced.gray_zone,\n    );\n    eprintln!(\n        \"  Economy:  100% LLM avoidance ({} issues, zero gray zone)\",\n        economy.total_issues,\n    );\n    eprintln!(\n        \"  MaxAccuracy: {:.1}% LLM avoidance, {} gray-zone issues for Tier 3\",\n        max_acc.llm_avoidance_pct(),\n        max_acc.gray_zone,\n    );\n    eprintln!(\n        \"  Tier 1 (not eligible): {} of {} total issues ({:.1}% handled deterministically)\",\n        balanced.not_eligible,\n        balanced.total_issues,\n        if balanced.total_issues > 0 {\n            (balanced.not_eligible as f64) / (balanced.total_issues as f64) * 100.0\n        } else {\n            0.0\n        },\n    );\n    eprintln!();\n\n    // Sanity: economy always zero gray zone.\n    assert_eq!(economy.gray_zone, 0);\n    // MaxAccuracy gray zone >= balanced.\n    assert!(max_acc.gray_zone >= balanced.gray_zone);\n}\n",
