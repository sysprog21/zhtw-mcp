n                if std::fs::write(&self.path, json).is_ok() {\n                    self.dirty = false;\n                }\n            }\n            Err(e) => log::warn!(\"failed to serialize judgment cache: {e}\"),\n        }\n    }\n}\n\nimpl Drop for JudgmentCache {\n    fn drop(&mut self) {\n        self.flush();\n    }\n}\n\nfn now_unix() -> u64 {\n    SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_secs()\n}\n\n/// Load the cache store from disk, or reset if schema version mismatch.\nfn load_or_reset(path: &Path) -> (CacheStore, bool) {\n    let data = match std::fs::read_to_string(path) {\n        Ok(d) => d,\n        Err(_) => return (CacheStore::default(), false),\n    };\n    match serde_json::from_str::<CacheStore>(&data) {\n        Ok(store) if store.schema_version == SCHEMA_VERSION => (store, false),\n        Ok(_old) => {\n            // Schema mismatch: backup and reset.\n            let backup = path.with_extension(\"json.bak\");\n            let _ = std::fs::rename(path, &backup);\n            log::info!(\n                \"judgment cache schema mismatch, backed up to {}\",\n                backup.display()\n            );\n            (CacheStore::default(), true)\n        }\n        Err(e) => {\n            log::warn!(\"failed to parse judgment cache: {e}, resetting\");\n            let backup = path.with_extension(\"json.bak\");\n            let _ = std::fs::rename(path, &backup);\n            (CacheStore::default(), true)\n        }\n    }\n}\n\n/// Make config_dir accessible from this module.\npub(crate) use super::store::config_dir;\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn test_key() -> JudgmentKey {\n        JudgmentKey {\n            ruleset_hash: \"abc123\".into(),\n            judgment_prompt_version: JUDGMENT_PROMPT_VERSION,\n            local_disambig_version: LOCAL_DISAMBIG_VERSION,\n            cost_mode: \"balanced\".into(),\n            profile: \"base\".into(),\n  