            "content": "// Incremental scan cache for CLI lint.\n//\n// Caches ScanOutput keyed on (file_path, content_hash, ruleset_hash,\n// profile, content_type, fix_mode).  Skips the entire scan pipeline on\n// cache hit.  TTL-based expiry (default 24h) prevents unbounded growth.\n//\n// MCP path does NOT use this cache (stateless by design).\n// Shared infrastructure with 33.3 hook cache (same storage dir, same\n// sha256 hashing via audit::sha256_hex).\n\nuse std::collections::HashMap;\nuse std::path::{Path, PathBuf};\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse serde::{Deserialize, Serialize};\n\nuse crate::audit::sha256_hex;\nuse crate::engine::scan::ScanOutput;\n\n/// Default TTL in seconds (24 hours).\nconst DEFAULT_TTL_SECS: u64 = 24 * 60 * 60;\n\n/// Cache key combining all inputs that affect scan output.\n#[derive(Debug, Clone, Hash, PartialEq, Eq, Serialize, Deserialize)]\nstruct CacheKey {\n    file_path: String,\n    content_hash: String,\n    ruleset_hash: String,\n    profile: String,\n    content_type: String,\n    fix_mode: String,\n}\n\n/// A single cached entry with timestamp for TTL expiry.\n#[derive(Debug, Clone, Serialize, Deserialize)]\nstruct CacheEntry {\n    key: CacheKey,\n    output: ScanOutput,\n    timestamp_secs: u64,\n}\n\n/// Persistent scan cache backed by a JSON file.\n#[derive(Debug)]\npub struct ScanCache {\n    path: PathBuf,\n    entries: HashMap<String, CacheEntry>,\n    ttl_secs: u64,\n    dirty: bool,\n}\n\nimpl ScanCache {\n    /// Open (or create) the scan cache at the default location.\n    pub fn open_default() -> Self {\n        let path = default_cache_path();\n        Self::open(path)\n    }\n\n    /// Open (or create) the scan cache at a specific path.\n    pub fn open(path: PathBuf) -> Self {\n        let entries = load_entries(&path);\n        ScanCache {\n            path,\n            entries,\n            ttl_secs: DEFAULT_TTL_SECS,\n            dirty: false,\n        }\n    }\n\n    /// Look up a cached scan result.  Returns None on cache miss or expired entry.\n    pub fn get(\n        &self,\n        file_path: &str,\n        content: &[u8],\n        ruleset_hash: &str,\n        profile: &str,\n        content_type: &str,\n        fix_mode: &str,\n    ) -> Option<&ScanOutput> {\n        let key = make_key(file_path, content, ruleset_hash, profile, content_type, fix_mode);\n        let key_hash = key_to_hash(&key);\n        let entry = self.entries.get(&key_hash)?;\n        // Check TTL.\n        let now = now_secs();\n        if now.saturating_sub(entry.timestamp_secs) > self.ttl_secs {\n            return None;\n        }\n        Some(&entry.output)\n    }\n\n    /// Store a scan result in the cache.\n    pub fn put(\n        &mut self,\n        file_path: &str,\n        content: &[u8],\n        ruleset_hash: &str,\n        profile: &str,\n        content_type: &str,\n        fix_mode: &str,\n        output: ScanOutput,\n    ) {\n        let key = make_key(file_path, content, ruleset_hash, profile, content_type, fix_mode);\n        let key_hash = key_to_hash(&key);\n        self.entries.insert(\n            key_hash,\n            CacheEntry {\n                key,\n                output,\n                timestamp_secs: now_secs(),\n            },\n        );\n        self.dirty = true;\n    }\n\n    /// Flush dirty cache to disk.  Prunes expired entries before writing.\n    /// Errors are silently ignored (cache is best-effort).\n    pub fn flush(&mut self) {\n        if !self.dirty {\n            return;\n        }\n        // Prune expired entries.\n        let now = now_secs();\n        let ttl = self.ttl_secs;\n        self.entries\n            .retain(|_, e| now.saturating_sub(e.timestamp_secs) <= ttl);\n\n        // Ensure parent directory exists.\n        if let Some(parent) = self.path.parent() {\n            let _ = std::fs::create_dir_all(parent);\n        }\n        // Write atomically via tempfile if possible, otherwise direct write.\n        let entries_vec: Vec<&CacheEntry> = self.entries.values().collect();\n        if let Ok(json) = serde_json::to_vec(&entries_vec) {\n            let _ = std::fs::write(&self.path, json);\n        }\n        self.dirty = false;\n    }\n}\n\nimpl Drop for ScanCache {\n    fn drop(&mut self) {\n        self.flush();\n    }\n}\n\n/// Default cache file location: ~/.cache/zhtw-mcp/scan-cache.json\nfn default_cache_path() -> PathBuf {\n    dirs_next_or_fallback()\n        .join(\"zhtw-mcp\")\n        .join(\"scan-cache.json\")\n}\n\n/// Best-effort ~/.cache resolution without adding a dependency.\nfn dirs_next_or_fallback() -> PathBuf {\n    // $XDG_CACHE_HOME > ~/.cache\n    if let Ok(xdg) = std::env::var(\"XDG_CACHE_HOME\") {\n        if !xdg.is_empty() {\n            return PathBuf::from(xdg);\n        }\n    }\n    if let Ok(home) = std::env::var(\"HOME\") {\n        return PathBuf::from(home).join(\".cache\");\n    }\n    // Last resort: /tmp\n    PathBuf::from(\"/tmp\")\n}\n\nfn make_key(\n    file_path: &str,\n    content: &[u8],\n    ruleset_hash: &str,\n    profile: &str,\n    content_type: &str,\n    fix_mode: &str,\n) -> CacheKey {\n    CacheKey {\n        file_path: file_path.to_owned(),\n        content_hash: sha256_hex(content),\n        ruleset_hash: ruleset_hash.to_owned(),\n        profile: profile.to_owned(),\n        content_type: content_type.to_owned(),\n        fix_mode: fix_mode.to_owned(),\n    }\n}\n\nfn key_to_hash(key: &CacheKey) -> String {\n    // Hash the key fields into a single lookup string.\n    let composite = format!(\n        \"{}|{}|{}|{}|{}|{}\",\n        key.file_path, key.content_hash, key.ruleset_hash, key.profile, key.content_type, key.fix_mode\n    );\n    sha256_hex(composite.as_bytes())\n}\n\nfn now_secs() -> u64 {\n    SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap_or_default()\n        .as_secs()\n}\n\nfn load_entries(path: &Path) -> HashMap<String, CacheEntry> {\n    let bytes = match std::fs::read(path) {\n        Ok(b) => b,\n        Err(_) => return HashMap::new(),\n    };\n    let entries: Vec<CacheEntry> = match serde_json::from_slice(&bytes) {\n        Ok(v) => v,\n        Err(_) => return HashMap::new(),\n    };\n    // Index by key hash, dropping expired entries eagerly.\n    let now = now_secs();\n    entries\n        .into_iter()\n        .filter(|e| now.saturating_sub(e.timestamp_secs) <= DEFAULT_TTL_SECS)\n        .map(|e| (key_to_hash(&e.key), e))\n        .collect()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::engine::scan::ScanOutput;\n    use crate::engine::zhtype::ChineseType;\n    use tempfile::TempDir;\n\n    fn empty_output() -> ScanOutput {\n        ScanOutput {\n            issues: vec![],\n            detected_script: ChineseType::Traditional,\n        }\n    }\n\n    #[test]\n    fn cache_hit_and_miss() {\n        let dir = TempDir::new().unwrap();\n        let path = dir.path().join(\"cache.json\");\n        let mut cache = ScanCache::open(path);\n\n        // Miss initially.\n        assert!(cache\n            .get(\"a.md\", b\"hello\", \"rh\", \"default\", \"markdown\", \"none\")\n            .is_none());\n\n        // Put then hit.\n        cache.put(\"a.md\", b\"hello\", \"rh\", \"default\", \"markdown\", \"none\", empty_output());\n        assert!(cache\n            .get(\"a.md\", b\"hello\", \"rh\", \"default\", \"markdown\", \"none\")\n            .is_some());\n\n        // Different content = miss.\n        assert!(cache\n            .get(\"a.md\", b\"world\", \"rh\", \"default\", \"markdown\", \"none\")\n            .is_none());\n\n        // Different profile = miss.\n        assert!(cache\n            .get(\"a.md\", b\"hello\", \"rh\", \"strict_moe\", \"markdown\", \"none\")\n            .is_none());\n    }\n\n    #[test]\n    fn cache_persists_to_disk() {\n        let dir = TempDir::new().unwrap();\n        let path = dir.path().join(\"cache.json\");\n\n        {\n            let mut cache = ScanCache::open(path.clone());\n            cache.put(\"b.md\", b\"data\", \"rh\", \"default\", \"plain\", \"none\", empty_output());\n            cache.flush();\n        }\n\n        // Reopen and verify hit.\n        let cache = ScanCache::open(path);\n        assert!(cache\n            .get(\"b.md\", b\"data\", \"rh\", \"default\", \"plain\", \"none\")\n            .is_some());\n    }\n\n    #[test]\n    fn expired_entries_pruned() {\n        let dir = TempDir::new().unwrap();\n        let path = dir.path().join(\"cache.json\");\n        let mut cache = ScanCache::open(path);\n        cache.ttl_secs = 0; // Expire immediately.\n        cache.put(\"c.md\", b\"x\", \"rh\", \"default\", \"plain\", \"none\", empty_output());\n        // Already expired.\n        assert!(cache\n            .get(\"c.md\", b\"x\", \"rh\", \"default\", \"plain\", \"none\")\n            .is_none());\n    }\n}\n",
