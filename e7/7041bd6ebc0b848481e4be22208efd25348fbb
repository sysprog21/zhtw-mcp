            "content": "// Formal benchmark for English anchor formalization as interlingual semantic layer.\n//\n// Measures: false-positive rejection rate, cache efficiency, resolution method\n// distribution, convergence speed, and latency overhead.\n//\n// Requires network access (Google Translate API) so marked #[ignore] by default.\n// Run explicitly:\n//   cargo test --test anchor_benchmark -- --ignored --nocapture\n//\n// Set CORPUS_DIR=path/to/dir to lint real-world .md/.txt files instead of\n// the built-in synthetic corpus.\n\nuse std::collections::HashMap;\nuse std::io::Write;\nuse std::process::{Command, Stdio};\nuse std::time::Instant;\n\nfn binary_path() -> std::path::PathBuf {\n    let mut path = std::env::current_exe().unwrap();\n    path.pop();\n    if path.ends_with(\"deps\") {\n        path.pop();\n    }\n    path.push(\"zhtw-mcp\");\n    path\n}\n\nfn run_lint_json(input: &str, extra_args: &[&str]) -> (String, std::time::Duration) {\n    let bin = binary_path();\n    let start = Instant::now();\n    let output = Command::new(&bin)\n        .args([\"lint\", \"--\"])\n        .args([\"--format\", \"json\"])\n        .args(extra_args)\n        .stdin(Stdio::piped())\n        .stdout(Stdio::piped())\n        .stderr(Stdio::piped())\n        .spawn()\n        .and_then(|mut child| {\n            child\n                .stdin\n                .take()\n                .unwrap()\n                .write_all(input.as_bytes())\n                .unwrap();\n            child.wait_with_output()\n        })\n        .unwrap();\n    let elapsed = start.elapsed();\n    let stdout = String::from_utf8_lossy(&output.stdout).to_string();\n    (stdout, elapsed)\n}\n\n/// Synthetic corpus: cross-strait terms in realistic sentence contexts.\n/// Each line has at least one known cross-strait substitution that the\n/// ruleset should detect. Terms span IT, general, political domains.\nfn synthetic_corpus() -> &'static str {\n    concat!(\n        // IT terms\n        \"這個軟件的質量很好，內存佔用也很低。\\n\",\n        \"我們正在優化視頻播放器的渲染引擎。\\n\",\n        \"請檢查服務器的網絡帶寬是否足夠。\\n\",\n        \"程序員在調試這段代碼的時候發現了問題。\\n\",\n        \"硬盤空間不足，需要清理緩存文件。\\n\",\n        \"該操作系統的內核支持多線程並發處理。\\n\",\n        \"移動端應用需要適配不同的分辨率。\\n\",\n        \"在雲計算平台上部署容器化的微服務架構。\\n\",\n        // General terms\n        \"他的表達方式非常簡練。\\n\",\n        \"這個方案的信息量很大。\\n\",\n        // Mixed: some terms should fire, some should not\n        \"使用正確的軟體開發方法論。\\n\",        // 軟體 is zh-TW, should NOT fire\n        \"正確的繁體中文排版很重要。\\n\",         // clean text\n    )\n}\n\n#[derive(Debug, Default)]\nstruct BenchmarkMetrics {\n    total_issues: usize,\n    issues_with_anchor: usize,\n    confirmed: usize,\n    rejected: usize,\n    unknown: usize,\n    method_distribution: HashMap<String, usize>,\n    avg_confidence: f64,\n    baseline_duration: std::time::Duration,\n    confirm_cold_duration: std::time::Duration,\n    confirm_warm_duration: std::time::Duration,\n    cold_json: String,\n    warm_json: String,\n    convergence_identical: bool,\n}\n\nfn parse_issues(json_str: &str) -> serde_json::Value {\n    serde_json::from_str(json_str).unwrap_or_else(|e| {\n        panic!(\n            \"Failed to parse JSON output: {e}\\nRaw output:\\n{json_str}\"\n        );\n    })\n}\n\nfn collect_metrics(corpus: &str) -> BenchmarkMetrics {\n    let mut m = BenchmarkMetrics::default();\n\n    // Run 1: baseline without --confirm\n    let (baseline_json, baseline_dur) = run_lint_json(corpus, &[]);\n    m.baseline_duration = baseline_dur;\n    let baseline = parse_issues(&baseline_json);\n    m.total_issues = baseline[\"total\"].as_u64().unwrap_or(0) as usize;\n\n    // Run 2: cold --confirm (cache may or may not be populated)\n    let (cold_json, cold_dur) = run_lint_json(corpus, &[\"--confirm\"]);\n    m.confirm_cold_duration = cold_dur;\n    m.cold_json = cold_json.clone();\n\n    // Run 3: warm --confirm (cache should be populated from run 2)\n    let (warm_json, warm_dur) = run_lint_json(corpus, &[\"--confirm\"]);\n    m.confirm_warm_duration = warm_dur;\n    m.warm_json = warm_json.clone();\n\n    // Parse confirmed output for per-issue analysis\n    let confirmed = parse_issues(&cold_json);\n    if let Some(issues) = confirmed[\"issues\"].as_array() {\n        for issue in issues {\n            if let Some(method) = issue[\"anchor_method\"].as_str() {\n                m.issues_with_anchor += 1;\n                *m.method_distribution\n                    .entry(method.to_string())\n                    .or_insert(0) += 1;\n\n                if let Some(conf) = issue[\"anchor_confidence\"].as_f64() {\n                    m.avg_confidence += conf;\n                    if conf >= 0.8 {\n                        m.confirmed += 1;\n                    } else if conf < 0.3 {\n                        m.rejected += 1;\n                    } else {\n                        m.unknown += 1;\n                    }\n                }\n            }\n        }\n    }\n    if m.issues_with_anchor > 0 {\n        m.avg_confidence /= m.issues_with_anchor as f64;\n    }\n\n    // Convergence: cold and warm JSON should produce identical issue lists\n    let cold_parsed = parse_issues(&cold_json);\n    let warm_parsed = parse_issues(&warm_json);\n    m.convergence_identical = cold_parsed[\"issues\"] == warm_parsed[\"issues\"];\n\n    m\n}\n\nfn print_report(m: &BenchmarkMetrics) {\n    println!(\"\\n========================================\");\n    println!(\"  Anchor Formalization Benchmark Report\");\n    println!(\"========================================\\n\");\n\n    // 1. Issue summary\n    println!(\"1. Issue Summary\");\n    println!(\"   Total issues detected:       {}\", m.total_issues);\n    println!(\"   Issues with anchor data:     {}\", m.issues_with_anchor);\n    println!(\n        \"   Anchor coverage:             {:.1}%\",\n        if m.total_issues > 0 {\n            m.issues_with_anchor as f64 / m.total_issues as f64 * 100.0\n        } else {\n            0.0\n        }\n    );\n    println!();\n\n    // 2. False-positive rejection\n    println!(\"2. False-Positive Rejection\");\n    println!(\n        \"   Confirmed (>= 0.8):          {} ({:.1}%)\",\n        m.confirmed,\n        pct(m.confirmed, m.issues_with_anchor)\n    );\n    println!(\n        \"   Rejected  (<  0.3):          {} ({:.1}%)\",\n        m.rejected,\n        pct(m.rejected, m.issues_with_anchor)\n    );\n    println!(\n        \"   Ambiguous (0.3-0.8):         {} ({:.1}%)\",\n        m.unknown,\n        pct(m.unknown, m.issues_with_anchor)\n    );\n    println!(\"   Avg confidence:              {:.3}\", m.avg_confidence);\n    println!();\n\n    // 3. Resolution method distribution\n    println!(\"3. Resolution Method Distribution\");\n    let mut methods: Vec<_> = m.method_distribution.iter().collect();\n    methods.sort_by(|a, b| b.1.cmp(a.1));\n    for (method, count) in &methods {\n        println!(\n            \"   {:<24} {:>3} ({:.1}%)\",\n            method,\n            count,\n            pct(**count, m.issues_with_anchor)\n        );\n    }\n    println!();\n\n    // 4. Latency\n    println!(\"4. Latency Analysis\");\n    println!(\n        \"   Baseline (no confirm):       {:>8.1}ms\",\n        m.baseline_duration.as_secs_f64() * 1000.0\n    );\n    println!(\n        \"   Cold confirm:                {:>8.1}ms\",\n        m.confirm_cold_duration.as_secs_f64() * 1000.0\n    );\n    println!(\n        \"   Warm confirm (cached):       {:>8.1}ms\",\n        m.confirm_warm_duration.as_secs_f64() * 1000.0\n    );\n    let overhead = if m.baseline_duration.as_nanos() > 0 {\n        (m.confirm_warm_duration.as_secs_f64() / m.baseline_duration.as_secs_f64() - 1.0) * 100.0\n    } else {\n        0.0\n    };\n    println!(\"   Warm overhead vs baseline:   {:>8.1}%\", overhead);\n    let speedup = if m.confirm_warm_duration.as_nanos() > 0 {\n        m.confirm_cold_duration.as_secs_f64() / m.confirm_warm_duration.as_secs_f64()\n    } else {\n        0.0\n    };\n    println!(\"   Cache speedup (cold/warm):   {:>8.1}x\", speedup);\n    println!();\n\n    // 5. Convergence\n    println!(\"5. Convergence (Multi-Run Stability)\");\n    println!(\n        \"   Cold vs warm identical:      {}\",\n        if m.convergence_identical {\n            \"YES (stable)\"\n        } else {\n            \"NO (non-deterministic)\"\n        }\n    );\n    println!();\n\n    println!(\"========================================\\n\");\n}\n\nfn pct(numerator: usize, denominator: usize) -> f64 {\n    if denominator == 0 {\n        0.0\n    } else {\n        numerator as f64 / denominator as f64 * 100.0\n    }\n}\n\n#[test]\n#[ignore]\nfn anchor_benchmark_synthetic() {\n    let corpus = synthetic_corpus();\n    let m = collect_metrics(corpus);\n    print_report(&m);\n\n    // Sanity assertions — the synthetic corpus has known cross-strait terms\n    assert!(\n        m.total_issues >= 5,\n        \"synthetic corpus should produce at least 5 issues, got {}\",\n        m.total_issues\n    );\n    assert!(\n        m.issues_with_anchor > 0,\n        \"at least some issues should have anchor data with --confirm\"\n    );\n}\n\n#[test]\n#[ignore]\nfn anchor_benchmark_corpus_dir() {\n    let corpus_dir = match std::env::var(\"CORPUS_DIR\") {\n        Ok(d) => d,\n        Err(_) => {\n            eprintln!(\"CORPUS_DIR not set, skipping corpus_dir benchmark\");\n            return;\n        }\n    };\n\n    let bin = binary_path();\n\n    // Run 1: baseline\n    let start = Instant::now();\n    let baseline_output = Command::new(&bin)\n        .args([\"lint\", &corpus_dir, \"--format\", \"json\"])\n        .stdout(Stdio::piped())\n        .stderr(Stdio::piped())\n        .output()\n        .unwrap();\n    let baseline_dur = start.elapsed();\n\n    // Run 2: cold confirm\n    let start = Instant::now();\n    let cold_output = Command::new(&bin)\n        .args([\"lint\", &corpus_dir, \"--format\", \"json\", \"--confirm\"])\n        .stdout(Stdio::pipe