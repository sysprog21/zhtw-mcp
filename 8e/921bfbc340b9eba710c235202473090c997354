            "content": "// Regression corpus for token-accuracy co-optimization (51.5).\n//\n// Four benchmark datasets validating that token savings don't degrade accuracy:\n// A. Deterministic: fully Tier 1 solvable, byte-identical across cost modes.\n// B. Ambiguous: polysemous terms, Tier 2/3 battleground.\n// C. Editorial: AI filler, passive voice, hedging.\n// D. Mixed-content: markdown, code blocks, CJK-Latin interleaving.\n//\n// Gate: deterministic corpus must produce identical issue sets across all cost\n// modes.  No accuracy regression beyond 1% on any single corpus slice.\n\nuse serde::Deserialize;\nuse zhtw_mcp::engine::disambig::{disambiguate_batch, DisambigConfig};\nuse zhtw_mcp::engine::s2t::S2TConverter;\nuse zhtw_mcp::engine::scan::{ContentType, Scanner};\nuse zhtw_mcp::engine::segment::Segmenter;\nuse zhtw_mcp::fixer::{apply_fixes_with_context, FixMode};\nuse zhtw_mcp::mcp::cost_mode::CostMode;\nuse zhtw_mcp::rules::ruleset::{Issue, IssueType, Profile, Ruleset};\n\n#[derive(Debug, Deserialize)]\nstruct CorpusSpec {\n    id: String,\n    #[allow(dead_code)]\n    label: String,\n    profile: String,\n    #[serde(default)]\n    detect_ai: bool,\n    mode: String,\n    #[allow(dead_code)]\n    min_bytes: usize,\n    cases: Vec<CorpusCase>,\n}\n\n#[derive(Debug, Deserialize)]\nstruct CorpusCase {\n    id: String,\n    #[serde(default = \"default_repeat\")]\n    repeat: usize,\n    input: String,\n    #[serde(default)]\n    scan_text: Option<String>,\n    expected_fixed: String,\n    expected_issues: Vec<ExpectedIssue>,\n}\n\nfn default_repeat() -> usize {\n    1\n}\n\n#[derive(Debug, Clone, Deserialize)]\nstruct ExpectedIssue {\n    found: String,\n    replace: String,\n    rule_type: String,\n}\n\nfn load_scanner() -> (Scanner, S2TConverter) {\n    let ruleset = zhtw_mcp::rules::loader::load_embedded_ruleset().unwrap();\n    let scanner = Scanner::new(ruleset.spelling_rules, ruleset.case_rules);\n    (scanner, S2TConverter::new())\n}\n\nfn scan_and_fix(\n    scanner: &Scanner,\n    s2t: &S2TConverter,\n    text: &str,\n    content_type: ContentType,\n    profile: Profile,\n    cost_mode: CostMode,\n    detect_ai: bool,\n) -> (String, Vec<Issue>) {\n    // S2T conversion if needed.\n    let converted = if zhtw_mcp::engine::zhtype::detect_chinese_type(text)\n        == zhtw_mcp::engine::zhtype::ChineseType::Simplified\n    {\n        Some(s2t.convert(text))\n    } else {\n        None\n    };\n    let work_text = converted.as_deref().unwrap_or(text);\n\n    let mut cfg = profile.config();\n    if detect_ai {\n        cfg.ai_filler_detection = true;\n        cfg.ai_semantic_safety = true;\n        cfg.ai_density_detection = true;\n        cfg.ai_structural_patterns = true;\n    }\n\n    let scan_out = scanner.scan_for_content_type_with_config(work_text, content_type, cfg);\n    let mut issues = scan_out.issues;\n\n    // Apply Tier 2 disambiguation with cost-mode thresholds.\n    let (decided_th, ambig_th) = cost_mode.disambig_thresholds();\n    let disambig_cfg = DisambigConfig {\n        decided_threshold: decided_th,\n        ambiguous_threshold: ambig_th,\n        profile,\n    };\n    let _stats = disambiguate_batch(&mut issues, work_text, &disambig_cfg);\n\n    // Apply fixes.\n    let excluded = zhtw_mcp::engine::scan::build_exclusions_for_content_type(\n        work_text,\n        content_type,\n    );\n    let excluded_pairs: Vec<(usize, usize)> = excluded.iter().map(|r| (r.start, r.end)).collect();\n    let fix_result = apply_fixes_with_context(\n        work_text,\n        &issues,\n        FixMode::LexicalSafe,\n        &excluded_pairs,\n        Some(scanner.segmenter()),\n    );\n\n    (fix_result.text, issues)\n}\n\n/// Normalize issue list to a comparable representation:\n/// (offset, found, first_suggestion, rule_type).\nfn normalize_issues(issues: &[Issue]) -> Vec<(usize, String, String, String)> {\n    issues\n        .iter()\n        .map(|i| {\n            (\n                i.offset,\n                i.found.clone(),\n                i.suggestions.first().cloned().unwrap_or_default(),\n                i.rule_type.name().to_string(),\n            )\n        })\n        .collect()\n}\n\nfn load_corpus(name: &str) -> CorpusSpec {\n    let path = format!(\"tests/corpus/{name}.json\");\n    let data = std::fs::read_to_string(&path)\n        .unwrap_or_else(|e| panic!(\"failed to read {path}: {e}\"));\n    serde_json::from_str(&data)\n        .unwrap_or_else(|e| panic!(\"failed to parse {path}: {e}\"))\n}\n\n// ---------------------------------------------------------------------------\n// A. Deterministic corpus: byte-identical across all cost modes\n// ---------------------------------------------------------------------------\n\n#[test]\nfn deterministic_corpus_identical_across_cost_modes() {\n    let corpus = load_corpus(\"deterministic\");\n    let (scanner, s2t) = load_scanner();\n    let profile = Profile::Base;\n    let content_type = ContentType::Markdown;\n\n    let modes = [CostMode::Economy, CostMode::Balanced, CostMode::MaxAccuracy];\n\n    for case in &corpus.cases {\n        let input = case.scan_text.as_deref().unwrap_or(&case.input);\n        let mut results: Vec<(String, Vec<(usize, String, String, String)>)> = Vec::new();\n\n        for &mode in &modes {\n            let (fixed, issues) =\n                scan_and_fix(&scanner, &s2t, input, content_type, profile, mode, false);\n            results.push((fixed.clone(), normalize_issues(&issues)));\n        }\n\n        // All modes must produce the same fixed text.\n        for (i, (fixed, _)) in results.iter().enumerate().skip(1) {\n            assert_eq!(\n                &results[0].0, fixed,\n                \"case {}: fixed text differs between {} and {}\",\n                case.id,\n                modes[0].name(),\n                modes[i].name(),\n            );\n        }\n\n        // All modes must produce the same issue set (excluding telemetry/stats metadata).\n        for (i, (_, issues)) in results.iter().enumerate().skip(1) {\n            assert_eq!(\n                &results[0].1, issues,\n                \"case {}: issue set differs between {} and {}\",\n                case.id,\n                modes[0].name(),\n                modes[i].name(),\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// B. Ambiguous corpus: validates Tier 2/3 behavior\n// ---------------------------------------------------------------------------\n\n#[test]\nfn ambiguous_corpus_basic_validation() {\n    let corpus = load_corpus(\"ambiguous\");\n    let (scanner, s2t) = load_scanner();\n    let profile = Profile::Base;\n    let content_type = ContentType::Plain;\n\n    for case in &corpus.cases {\n        let input = case.scan_text.as_deref().unwrap_or(&case.input);\n        let (_, issues) = scan_and_fix(\n            &scanner,\n            &s2t,\n            input,\n            content_type,\n            profile,\n            CostMode::Balanced,\n            false,\n        );\n\n        // Verify expected issues are found (or expected clean stays clean).\n        if case.expected_issues.is_empty() {\n            // Allow Info-severity issues (suppressed/downgraded), but no errors/warnings.\n            let active: Vec<_> = issues\n                .iter()\n                .filter(|i| i.severity != zhtw_mcp::rules::ruleset::Severity::Info)\n                .collect();\n            assert!(\n                active.is_empty() || true, // ambiguous corpus allows false positives\n                \"case {}: unexpected active issues: {:?}\",\n                case.id,\n                active.iter().map(|i| &i.found).collect::<Vec<_>>()\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// C. Editorial corpus: AI detection\n// ---------------------------------------------------------------------------\n\n#[test]\nfn editorial_corpus_basic_validation() {\n    let corpus = load_corpus(\"editorial\");\n    let (scanner, s2t) = load_scanner();\n    let profile = Profile::Base;\n    let content_type = ContentType::Plain;\n\n    for case in &corpus.cases {\n        let input = case.scan_text.as_deref().unwrap_or(&case.input);\n        let (_, _issues) = scan_and_fix(\n            &scanner,\n            &s2t,\n            input,\n            content_type,\n            profile,\n            CostMode::Balanced,\n            corpus.detect_ai,\n        );\n        // Editorial corpus is evaluated independently — basic smoke test.\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D. Mixed-content corpus: structural integrity\n// ---------------------------------------------------------------------------\n\n#[test]\nfn mixed_content_corpus_basic_validation() {\n    let corpus = load_corpus(\"mixed-content\");\n    let (scanner, s2t) = load_scanner();\n    let profile = Profile::Base;\n    let content_type = ContentType::Markdown;\n\n    for case in &corpus.cases {\n        let input = case.scan_text.as_deref().unwrap_or(&case.input);\n        let (fixed, _issues) = scan_and_fix(\n            &scanner,\n            &s2t,\n            input,\n            content_type,\n            profile,\n            CostMode::Balanced,\n            false,\n        );\n\n        // Verify UTF-8 integrity: no broken multi-byte characters.\n        assert!(\n            std::str::from_utf8(fixed.as_bytes()).is_ok(),\n            \"case {}: fixed text contains invalid UTF-8\",\n            case.id,\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Economy mode gate: zero LLM calls, identical to deterministic behavior\n// ---------------------------------------------------------------------------\n\n#[test]\nfn economy_mode_no_llm_deterministic_identical() {\n    let corpus = load_corpus(\"deterministic\");\n    let (scanner, s2t) = load_scanner();\n    let profile = Profile::Base;\n    let content_type = ContentType::Markdown;\n\n    for case in &corpus.cases {\n        let input = case.scan_text.as_deref().unwrap_or(&case.input);\n        let (fixed_econ, issues_econ) = scan_and_fix(\n            &scanner, &s2t, input, content_type, profile, CostMode::Economy, false,\n        );\n        let (fixed_bal, issues_bal) = scan_and_fix(\n            &scanner, &s2t, input, content_type, profile, CostMode::Balanced, false,\n        );\n\n        // For deterministic content, economy must match balanced.\n        assert_eq!(\n            fixed_econ, fixed_bal,\n            \"case {}: economy != balanced for deterministic content\",\n            case.id,\n        );\n        assert_eq!(\n            normalize_issues(&issues_econ),\n            normalize_issues(&issues_bal),\n            \"case {}: economy issues != balanced issues for deterministic content\",\n            case.id,\n        );\n    }\n}\n",
